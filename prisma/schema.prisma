// Bike Land — schéma de données
// Cahier des charges §6.1 : PostgreSQL + Prisma.
// La contrainte métier centrale est l'absence de double réservation :
// elle est garantie par la transaction sérialisable de src/lib/booking/create.ts
// et par l'index (bikeId, startDate, endDate) ci-dessous.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------- Sécurité de l'administration

/// Réglages sensibles de l'administration, aujourd'hui le secret de la
/// double authentification, rangé chiffré (cf. src/lib/double-authentification.ts).
model ParametreAdmin {
  cle       String   @id
  valeur    String
  updatedAt DateTime @updatedAt
}

/// Compteurs d'essais partagés par tous les serveurs : connexions, codes
/// de double authentification, messages de contact. Incrémentés en une
/// seule requête atomique (cf. src/lib/db/postgres.ts, compterEssai).
model CompteurEssais {
  cle      String   @id
  nombre   Int
  expireLe DateTime
}

// ---------------------------------------------------------------- Parc de vélos

enum BikeTier {
  CLASSIQUE
  PREMIUM
  PRESTIGE
}

enum BikeCategory {
  VTT
  RANDONNEUR // vélo de voyage classique, sacoches, longue distance
  GRAVEL     // mixte route / piste
  VAE        // vélo à assistance électrique
  VTC        // vélo tout chemin, polyvalent
  TANDEM     // deux places
}

enum BikeSize {
  S
  M
  L
  XL
}

enum BikeStatus {
  DISPONIBLE
  EN_LOCATION
  MAINTENANCE
  RETIRE
}

model Bike {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  category    BikeCategory
  /// Gamme commerciale : c'est elle qui commande le prix (cf. src/data/offres.ts).
  tier        BikeTier     @default(CLASSIQUE)
  size        BikeSize
  status      BikeStatus   @default(DISPONIBLE)
  shortPitch  String
  description String       @db.Text

  // Aucun montant n'est porté par le vélo : ni prix, ni caution. Le tarif
  // vient de la formule choisie et la caution est un forfait unique de la
  // location libre (cf. src/data/offres.ts). Les anciennes colonnes
  // dailyPriceXof et depositXof ont été retirées : elles faisaient croire
  // à une tarification par machine qui n'existe pas.

  // Caractéristiques affichées sur la fiche produit (§2.1)
  weightKg          Float
  gearCount         Int
  maxLoadKg         Int
  suggestedRangeKm  Int
  assistanceRangeKm Int? // uniquement pour les VAE
  motorWatts        Int?
  batteryWh         Int?

  includedEquipment String[] // « équipement inclus » de la fiche produit
  heroImageUrl      String?
  /// Présentation vidéo, servie depuis `public`. Remplace la photo sur la fiche.
  videoUrl          String?
  galleryImageUrls  String[]

  pickupPointId String?
  pickupPoint   PickupPoint? @relation(fields: [pickupPointId], references: [id])

  bookingItems     BookingItem[]
  reviews          Review[]
  maintenanceLogs  MaintenanceLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, status])
  @@index([pickupPointId])
}

// Point de retrait / restitution (§8 : un seul lieu ou plusieurs, à trancher)
model PickupPoint {
  id        String   @id @default(cuid())
  name      String
  city      String
  address   String
  latitude  Float?
  longitude Float?
  openingHours String?
  isActive  Boolean  @default(true)

  bikes    Bike[]
  bookings Booking[]

  createdAt DateTime @default(now())
}

model MaintenanceLog {
  id        String   @id @default(cuid())
  bikeId    String
  bike      Bike     @relation(fields: [bikeId], references: [id], onDelete: Cascade)
  label     String
  notes     String?  @db.Text
  performedAt DateTime @default(now())
  nextDueAt   DateTime?

  @@index([bikeId, performedAt])
}

// ---------------------------------------------------------------- Clients

// Le client ne crée pas de compte (§2.1). La fiche client est constituée
// automatiquement à chaque réservation, dédoublonnée sur l'email.
model Customer {
  id        String    @id @default(cuid())
  email     String    @unique
  firstName String
  lastName  String
  phone     String?
  locale    String    @default("fr")

  bookings  Booking[]
  reviews   Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------- Réservations

// L'offre commande le prix, la caution et les exigences au depart.
enum BookingOffer {
  ROAD_TRIP       // sortie encadree, forfait par personne, sans caution
  LOCATION_LIBRE  // velo sans accompagnement, grille horaire, caution
  OCTOBRE_ROSE    // sortie de saison, prix unique, un velo attribue par participant
  GBASHI_BIKE     // sortie sur commande, au comptoir : prix de la gamme par personne
  PADEL_BIKE      // sortie sur commande, au comptoir : prix unique, velos attribues d office
}

enum BookingStatus {
  EN_ATTENTE_PAIEMENT
  CONFIRMEE
  EN_COURS
  TERMINEE
  ANNULEE
}

model Booking {
  id        String        @id @default(cuid())
  reference String        @unique // ex. BL-2K4M7Q, communiquée au client
  status    BookingStatus @default(EN_ATTENTE_PAIEMENT)

  // Valeurs par defaut : les reservations anterieures a l'introduction
  // des deux offres sont toutes des sorties encadrees a une personne.
  offer       BookingOffer @default(ROAD_TRIP)
  peopleCount Int          @default(1)
  /// Duree en heures, renseignee en location libre uniquement.
  durationHours Int?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  /// Prénom, nom et téléphone tels que saisis pour CETTE réservation. La
  /// fiche client, partagée par toutes les réservations d'une même
  /// adresse, n'est plus réécrite par un inconnu qui réserverait avec
  /// l'adresse d'un autre ; c'est cette copie qui sert aux emails et à
  /// l'admin. Vides sur les réservations antérieures : la fiche sert alors.
  contactFirstName String?
  contactLastName  String?
  contactPhone     String?

  pickupPointId String?
  pickupPoint   PickupPoint? @relation(fields: [pickupPointId], references: [id])

  startDate DateTime @db.Date
  endDate   DateTime @db.Date // dernier jour de location inclus
  days      Int

  /// Heure de début et de fin, sur la journée de la sortie. Le road trip
  /// part à 8 h pour finir à 11 h ; la location libre choisit son heure.
  /// Les valeurs par défaut correspondent au créneau encadré historique.
  startHour Int @default(8)
  endHour   Int @default(11)
  /// L'horaire exact, « 18:30 » et « 22:30 », d'une sortie réglée à la
  /// minute dans l'administration (Padel bike) : le client garde celui
  /// qu'il a payé, même si le réglage change ensuite. Vides ailleurs, les
  /// heures pleines suffisent.
  startTime String?
  endTime   String?

  subtotalXof Int
  optionsXof  Int @default(0)
  discountXof Int @default(0)
  depositXof  Int @default(0)
  totalXof    Int

  // Accès au suivi de réservation sans authentification (§2.1, §6.1) :
  // le lien envoyé par email porte un token signé, ce champ n'en stocke
  // que le hachage.
  accessTokenHash String  @unique
  notes           String? @db.Text

  items    BookingItem[]
  options  BookingOption[]
  payments Payment[]
  review   Review?
  /// Code promo utilisé, s'il y en a un. Une réservation au maximum par
  /// utilisation : c'est cette ligne qui rattache le client au partenaire.
  promoUsage PromoUsage?

  confirmedAt DateTime?
  cancelledAt DateTime?
  /// Quand le rappel de la veille est parti, `null` tant qu'il ne l'est
  /// pas. La tâche quotidienne le marque avant d'envoyer : un rappel ne
  /// part jamais deux fois, même si la tâche est appelée plusieurs fois.
  reminderSentAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, startDate])
  @@index([startDate, endDate])
}

model BookingItem {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bikeId    String
  bike      Bike    @relation(fields: [bikeId], references: [id])

  // Dates dupliquées depuis la réservation : c'est ce couple qui est
  // interrogé pour la disponibilité temps réel d'un vélo donné.
  //
  // Les heures s'y ajoutent depuis que deux clients peuvent louer le même
  // vélo le même jour — l'un le matin, l'autre l'après-midi. Sans elles,
  // le premier bloquerait la journée entière.
  startDate     DateTime @db.Date
  endDate       DateTime @db.Date
  startHour     Int      @default(8)
  endHour       Int      @default(11)
  unitPriceXof  Int
  lineTotalXof  Int

  @@unique([bookingId, bikeId])
  @@index([bikeId, startDate, endDate])
}

model BookingOption {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  code      String  // casque, sacoches, assurance, transfert...
  label     String
  priceXof  Int
  quantity  Int     @default(1)
}

// ---------------------------------------------------------------- Paiement

enum PaymentProvider {
  // FEDAPAY et KKIAPAY ne sont plus utilisés : le compte KkiaPay n'a
  // jamais été validé. Les valeurs restent pour ne pas orpheliner les
  // paiements déjà enregistrés sous ces noms.
  FEDAPAY
  KKIAPAY
  SASPAY
  ESPECES // encaissement au comptoir, saisi par l'administrateur
}

enum PaymentMethod {
  MTN_MONEY
  MOOV_MONEY
  CELTIIS_CASH
  ESPECES
}

enum PaymentStatus {
  INITIE
  REUSSI
  ECHOUE
  REMBOURSE
}

model Payment {
  id        String          @id @default(cuid())
  bookingId String
  booking   Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  provider  PaymentProvider
  method    PaymentMethod
  status    PaymentStatus   @default(INITIE)
  amountXof Int

  providerReference String? @unique // identifiant de transaction FedaPay / KkiaPay
  failureReason     String?

  // Caution encaissée puis restituée (indicateur financier §2.3)
  isDeposit  Boolean   @default(false)
  refundedAt DateTime?

  /// Qui a reçu l'argent d'une vente en espèces saisie dans
  /// l'administration. Vide pour un paiement en ligne.
  collectedBy String?
  /// Ce qui a été rendu au client, en FCFA, quand le paiement passe à
  /// REMBOURSE : tout pour une vente annulée au comptoir, la part prévue
  /// par les CGV quand le client a annulé lui-même.
  refundedXof Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([method])
}

model Invoice {
  id        String   @id @default(cuid())
  bookingId String   @unique
  number    String   @unique // ex. FA-2026-0042
  totalXof  Int
  pdfUrl    String?
  issuedAt  DateTime @default(now())
  sentAt    DateTime?
}

// ---------------------------------------------------------------- Avis (§2.1)

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bikeId    String
  bike      Bike     @relation(fields: [bikeId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  rating    Int      // 1 à 5
  title     String?
  comment   String?  @db.Text
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([bikeId, isPublished])
}

// La tarification ne vit plus en base : elle n'a que deux formes, le
// forfait du road trip et la grille horaire de la location libre, toutes
// deux déclarées dans src/data/offres.ts. L'ancien modèle PriceRule
// (remises de durée, majorations de saison, tarifs par catégorie) a été
// retiré : il décrivait une activité que Bike Land n'exerce pas.

// Demandes issues du formulaire de contact (§2.1)
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  handledAt DateTime?
  createdAt DateTime @default(now())

  @@index([handledAt, createdAt])
}

/* ------------------------------------------------- Parrainage partenaires */

/**
 * Un partenaire qui nous apporte des clients.
 *
 * Hôtel, agence de voyage, restaurant, guide : chacun a son code de
 * parrainage, et c'est le code qui permet de savoir qui a apporté qui.
 * Sans cette table, on saurait qu'une réduction a été accordée, mais pas à
 * qui verser la commission.
 */
model Partner {
  id      String  @id @default(cuid())
  name    String  @unique
  /// Téléphone ou email : à qui l'on parle chez ce partenaire.
  contact String?
  notes   String? @db.Text
  /// Un partenariat qui s'arrête se désactive, il ne s'efface pas : ses
  /// codes ont déjà servi et l'historique doit rester lisible.
  isActive Boolean @default(true)

  promoCodes PromoCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Conservé pour les colonnes existantes de PromoCode.
 *
 * La réduction est désormais une politique unique (1 % au client, 5 % de
 * commission au partenaire, cf. src/lib/parrainage.ts) et non plus une
 * valeur par code. L'énumération reste déclarée parce que la colonne
 * existe en base : la retirer exigerait une migration destructive pour
 * aucun bénéfice.
 */
enum PromoKind {
  POURCENTAGE
  MONTANT_FIXE
}

/**
 * Un code de parrainage, toujours rattaché à un partenaire.
 *
 * Le nom des tables — PromoCode, PromoUsage — est antérieur au passage au
 * vocabulaire du parrainage. Il est conservé : renommer une table en
 * production demande une migration, et ces noms ne sont vus par personne
 * d'autre que le code.
 *
 * `useCount` est dénormalisé : il pourrait se compter sur `PromoUsage`,
 * mais le quota doit être vérifié dans la transaction qui crée la
 * réservation, et un compteur se verrouille là où un COUNT ne le fait pas.
 */
model PromoCode {
  code String @id // en majuscules, c'est l'identifiant lisible du code

  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  /// Vestiges du temps où chaque code portait sa propre valeur. Ils sont
  /// désormais écrits depuis les constantes de src/lib/parrainage.ts et ne
  /// sont plus lus pour calculer quoi que ce soit.
  kind  PromoKind
  value Int

  /// Fenêtre de validité. Les deux bornes sont facultatives : un code sans
  /// date de fin reste valable jusqu'à ce qu'on le désactive.
  startsAt DateTime?
  endsAt   DateTime?

  /// Nombre d'utilisations autorisées. `null` : sans limite.
  maxUses  Int?
  useCount Int  @default(0)

  isActive Boolean @default(true)

  usages PromoUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId])
}

/**
 * Où en est une utilisation de code.
 *
 *  - `EN_ATTENTE` : le code est appliqué, la réservation créée, mais le
 *    client n'a pas encore payé. Le partenaire ne l'a pas gagné.
 *  - `VALIDE` : le paiement est confirmé. C'est là, et seulement là, que
 *    le client compte pour le partenaire et que la commission est due.
 *  - `ANNULE` : le paiement a échoué, ou la réservation a été annulée.
 */
enum PromoUsageStatus {
  EN_ATTENTE
  VALIDE
  ANNULE
}

/**
 * Une utilisation d'un code de parrainage sur une réservation.
 *
 * C'est la table qui répond à la question posée : combien de clients tel
 * partenaire a-t-il apportés, et combien lui devons-nous. Les deux
 * montants y sont **figés** : les taux sont une politique, et une
 * politique change. Recalculer une commission de 2024 avec le taux de
 * 2026 fausserait tout l'historique des versements.
 */
model PromoUsage {
  id String @id @default(cuid())

  promoCode String
  promo     PromoCode @relation(fields: [promoCode], references: [code], onDelete: Cascade)

  /// Une réservation ne peut porter qu'un code.
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// Réduction accordée au client, en FCFA.
  discountXof Int
  /// Commission due au partenaire, en FCFA. Figée au taux du jour.
  commissionXof Int @default(0)

  /// Tant que ce n'est pas VALIDE, le partenaire ne compte ni ce client
  /// ni sa commission. Un paiement non abouti ne rapporte rien.
  status      PromoUsageStatus @default(EN_ATTENTE)
  validatedAt DateTime?

  createdAt DateTime @default(now())

  @@index([promoCode])
  @@index([status])
}

/// État d'un créneau de road trip, choisi depuis le tableau de bord.
///
/// Sans ligne, le créneau suit sa valeur par défaut, écrite dans
/// src/data/offres.ts. Une ligne n'existe donc que pour un créneau dont
/// l'exploitant a changé l'état.
model CreneauReglage {
  code      String   @id
  actif     Boolean
  updatedAt DateTime @updatedAt
}

/// Un jour fermé à la réservation en ligne : complet, sortie privée,
/// atelier fermé. Les réservations déjà prises ce jour-là restent valables,
/// seules les nouvelles sont refusées.
model JourFerme {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  /// « road-trip », « location-libre » ou « toutes ».
  formule   String
  motif     String?
  createdAt DateTime @default(now())

  @@unique([date, formule])
  @@index([date])
}
